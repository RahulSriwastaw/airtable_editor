# ==============================================================================
# Environment Configuration Template - Test Factory MCQ Manager
# Copy this file to .env and fill in your credentials
# ==============================================================================

# Gemini AI API Configuration
# Required for Gemini AI API calls (configured in AI Studio or user secrets)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Application URL
APP_URL="http://localhost:3000"

# Airtable API Configuration
# AIRTABLE_API_KEY: Personal Access Token (pat...) for Airtable read/write access
AIRTABLE_API_KEY=""

# AIRTABLE_BASE_ID: The primary Airtable Base ID (app...) for Test Factory MCQ questions
AIRTABLE_BASE_ID=""
AIRTABLE_BASE_NAME="Test Factory"

# AIRTABLE_SSC_GD_BASE_ID: Secondary Airtable Base ID (app...)
AIRTABLE_SSC_GD_BASE_ID=""

# ImgBB API Configuration
# API key for hosting pasted images and media assets
IMGBB_API_KEY=""

# Firebase Client Configuration (Vite import.meta.env)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_FIRESTORE_DATABASE_ID=""
VITE_FIREBASE_OAUTH_CLIENT_ID=""
